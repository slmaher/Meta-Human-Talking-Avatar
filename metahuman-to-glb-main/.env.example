# -----------------------------------------------------------------------------
# Server-side Environment Variables for Bo MetaHuman AI Pipeline
# NEVER expose these API keys in browser/client code.
# -----------------------------------------------------------------------------

# --- LLM Configuration ---
# Supports Google Gemini, OpenAI, or compatible chat completion APIs.
# For Google Gemini (Recommended): Set LLM_API_KEY to your Gemini API key (e.g. AIza...)
# For OpenAI: Set LLM_API_KEY to sk-... and LLM_MODEL to gpt-4o-mini
LLM_API_KEY=AQ.Ab8RN6J4L0ZL8vxEUQF7CT3prqLJH_iwHGHLYL9grqVlk_oYOw
LLM_MODEL=gemini-1.5-flash

# Optional individual provider overrides:
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- ElevenLabs Text-to-Speech Configuration ---
# API key from https://elevenlabs.io
ELEVENLABS_API_KEY=sk_30e137d0a1ee5e8790a0749e7920ccec768cdbbddc373c6b

# Voice ID for Bo (default MetaHuman male voice)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ElevenLabs Model ID (eleven_turbo_v2_5 is lowest latency for conversational AI)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Server Options ---
PORT=5173
